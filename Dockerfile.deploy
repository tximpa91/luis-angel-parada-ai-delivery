FROM hashicorp/terraform:1.16.0 AS terraform

# Wrangler's local workerd engine requires glibc; keep the toolchain usable for
# both deployment validation and Docker-only Worker development.
FROM node:22-bookworm-slim

# Terraform needs the system CA bundle to reach registry.terraform.io; the slim image ships without it.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=terraform /bin/terraform /usr/local/bin/terraform

WORKDIR /workspace

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV CI=1

CMD ["node", "scripts/deploy.mjs"]
