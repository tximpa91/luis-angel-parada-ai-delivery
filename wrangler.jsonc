{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luis-angel-parada-ai-delivery",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-22",
  "containers": [
    {
      "class_name": "WebsiteContainer",
      "image": "./Dockerfile",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WEBSITE_CONTAINER",
        "class_name": "WebsiteContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WebsiteContainer"]
    }
  ]
}
