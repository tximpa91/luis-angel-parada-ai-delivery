{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luis-angel-parada-ai-delivery",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  }
}
